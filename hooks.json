{
  "numerical-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hook_pre_tool_guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ./scripts/hook_test_guard.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hook_record_edit.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./scripts/hook_stop_gate.py",
        "timeout": 60
      }
    ]
  }
}
